rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Student ID cards ──────────────────────────────────────────────
    match /student-ids/{uid}/{file} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin(request.auth.uid));
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024  // 5 MB max
        && request.resource.contentType.matches('image/.*');
    }

    // ── Business licenses ────────────────────────────────────────────
    match /business-licenses/{uid}/{file} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin(request.auth.uid));
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024  // 10 MB max
        && request.resource.contentType.matches('application/pdf|image/.*');
    }

    // ── Resume certificates ──────────────────────────────────────────
    match /certificates/{studentUid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == studentUid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*');
    }

    // ── Banner images (admin only) ───────────────────────────────────
    match /banners/{file} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // ── Helper ───────────────────────────────────────────────────────
    function isAdmin(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid)).data.role == 'admin';
    }
  }
}
